# Python: bytecode y artefactos
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/

# Caches de herramientas y cobertura
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# SECRETOS: nunca versionar. La excepcion es la plantilla sin valores reales.
.env
.env.*
!.env.example

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Videos locales: se suben al servidor, NO al repo (pesan demasiado).
# La carpeta se conserva con .gitkeep.
src/fastapi_2026/static/videos/*
!src/fastapi_2026/static/videos/.gitkeep
