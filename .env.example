# Plantilla de configuracion. Copiala como .env y rellena los valores reales.
# .env esta en .gitignore: NUNCA subir llaves a GitHub.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Firma de sesiones / JWT. Genera una propia, no uses esta.
SECRET_KEY=cambia_esto_por_una_clave_larga_y_segura

# Opcionales
SUPABASE_JWKS_URL=
SESSION_SECRET=
ENVIRONMENT=development
APP_NAME=Mi Web
DEBUG=false

# Tienda
SHIPPING_COST=5.00
FREE_SHIPPING_THRESHOLD=50.00
